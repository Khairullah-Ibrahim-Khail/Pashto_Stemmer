*.swp

# LaTeX build artefacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.toc
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk

# Working files from the annotation and audit process.
#
# The annotation history is NOT ignored: pashto_gold(1).csv is the first
# independent annotation and pashto_gold_corrected.csv the intermediate
# revision, and the paper's claim that the later revisions are worth 0.20
# points cannot be checked without them. keep_whole_candidates.csv and
# verb_rows_to_update.csv are cited in the paper for the same reason.
#
# Only genuinely derivable intermediates are ignored here; each is regenerated
# by a script in experiments/.
dataset/unreached_words.csv
dataset/not_reachable_words.csv
dataset/yeh_variant_rows.csv
dataset/space_bug_fixes.csv

# Generated documents: rebuild with the scripts in docs/ and paper/
docs/*.docx

# The paper itself ships in both formats, so the built Word and PDF versions
# are tracked rather than ignored. Anything else generated in paper/ is not.
paper/*.docx
paper/*.pdf
!paper/Pashto_Stemmer_Paper.docx
!paper/Pashto_Stemmer_Paper.pdf
