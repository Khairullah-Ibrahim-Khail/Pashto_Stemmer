# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/
.venv/
venv/
env/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# LaTeX build artefacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.toc
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk

# Working files from the annotation and audit process.
#
# dataset/annotations/ holds the individual annotation passes and is released:
# experiments/agreement.py recomputes the inter-annotator figures from them.
# keep_whole_candidates.csv and verb_rows_to_update.csv are cited in the paper
# and are released too.
#
# pashto_gold(1).csv and pashto_gold_corrected.csv are early drafts that were
# superseded. They are not an annotation pass and are not evidence of anything,
# so they are not released.
dataset/pashto_gold(1).csv
dataset/pashto_gold_corrected.csv
dataset/unreached_words.csv
dataset/not_reachable_words.csv
dataset/yeh_variant_rows.csv
dataset/space_bug_fixes.csv

# Generated documents: rebuild with the scripts in docs/ and paper/
docs/*.docx

# The repository ships the paper's LaTeX source and the built PDF. The Word
# version and the script that generates it are kept locally and not tracked:
# build_paper_docx.py holds the whole manuscript a second time as Python
# strings, which duplicates main.tex and drifted from it twice. One source,
# one built artefact.
paper/*.docx
paper/*.pdf
paper/build_paper_docx.py
!paper/Pashto_Stemmer_Paper.pdf

# Third-party material. Aslamzai & Saad (2015) is someone else's copyrighted
# paper; it is cited in the references, not redistributed here. Our own
# transcription of its nine rules is in docs/Aslamzai_Saad_2015_Rules.pdf.
resources/

# Superseded documents. The annotation guidelines PDF carries the abandoned
# first protocol (a template pre-filled with the stemmer's output) and
# contradicts the released policy; docs/02_annotation_policy.md is current.
dataset/ANNOTATION_GUIDELINES.pdf

# The standalone rules PDF describes a twelve-rule pipeline that the system no
# longer has. Section IV and Appendix A of the paper replace it.
docs/Pashto_Stemmer_Rules.pdf
docs/Pashto_Stemmer_Rules.docx

# Output of examples/stem_csv.py; the script regenerates it.
examples/sample_words_stemmed.csv

# ---------------------------------------------------------------------------
# ir/ -- the retrieval evaluation (Section on downstream effectiveness)
# ---------------------------------------------------------------------------

# The document collection: 44,814 news documents, 177 MB, one .txt per
# document. It is third-party news text and far too large to track here;
# ir/data_loader.py rebuilds it from the source corpus. The relevance
# judgements that point into it are tracked, and ir/remap_qrels.py carries
# them across a re-split.
ir/corpus/

# Retrieved rankings, regenerated by ir/run_experiment.py in a few minutes.
ir/results/run_unstemmed.txt
ir/results/run_stemmed.txt

# Dated safety copies written automatically before each destructive step.
ir/results/backup-*/
ir/data/backup-*/

# NOT ignored, deliberately: ir/data/ holds the queries and the qrels, and
# ir/results/judged_*.tsv and ir/results/frozen/ hold the relevance
# judgements. Those are 1,489 human decisions that cannot be regenerated
# without re-judging every document by hand.

# Working files from the judging process. All of them stay on disk; none is
# needed to reproduce or verify the result, and each was checked before being
# excluded here:
#
#   queries.sample.tsv          referenced by no script and no document
#   queries_all_heldout.tsv     empty file
#   disagreements.tsv           empty; judge_agreement.py regenerates it
#   results.json                run_experiment.py regenerates it in minutes
#   *.partial8.tsv              8 rows, superseded by the 1,489-row files
#   qrels_classmate.round1.tsv  byte-identical to qrels_classmate.tsv
#
# What is NOT excluded: judged_khairullah.tsv, judged_classmate.tsv, the
# current qrels_*.tsv, results/frozen/ and recheck_truncated.md. Those are the
# relevance judgements and the record of how they were revised, and they
# cannot be regenerated without re-judging every document by hand.
ir/data/queries.sample.tsv
ir/data/queries_all_heldout.tsv
ir/results/disagreements.tsv
ir/results/results.json
ir/results/*.partial8.tsv
ir/results/qrels_classmate.round1.tsv

# Stale worklist: the nine queries it lists have since been judged, and it
# still quotes the 1,174-judgement count from before they were added.
ir/REMAINING_QUERIES.md

# Archives: build output and folder zips are not sources
*.zip
